{
  "permissions": {
    "allow": [
      "mcp__todoist"
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "mise exec node@lts -- npx -y ccstatusline@latest",
    "padding": 0,
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "egm@egm": true,
    "mattpocock-skills@claude-plugins-official": true,
    "session-gist@system-files": true,
    "sdlc@softwaregravy-sdlc": false
  },
  "extraKnownMarketplaces": {
    "egm": {
      "source": {
        "source": "github",
        "repo": "google/elephant-goldfish-model"
      }
    },
    "system-files": {
      "source": {
        "source": "directory",
        "path": "/home/johnhin/workspaces/system_files/claude/plugins"
      }
    },
    "softwaregravy-sdlc": {
      "source": {
        "source": "github",
        "repo": "softwaregravy/softwaregravy-sdlc"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "theme": "dark",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
