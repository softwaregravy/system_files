{
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "session-gist@system-files": true,
    "sdlc@softwaregravy-sdlc": false
  },
  "extraKnownMarketplaces": {
    "system-files": {
      "source": {
        "source": "directory",
        "path": "/Users/john/workspace/system_files/claude/plugins"
      }
    },
    "softwaregravy-sdlc": {
      "source": {
        "source": "github",
        "repo": "softwaregravy/softwaregravy-sdlc"
      }
    }
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      " "
    ]
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "theme": "dark"
}
